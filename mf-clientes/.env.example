# URL do API Gateway (ou do BFF, em desenvolvimento). Nunca a URL do microsserviço.
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/prod
# API key do usage plan do API Gateway (vazio em desenvolvimento local)
VITE_API_KEY=
# Usuário simulado quando o MF roda sozinho (u3 = Administrador no Mini CRM)
VITE_USUARIO_ID=u3
