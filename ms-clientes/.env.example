# Variáveis do MS Clientes (nunca commite o .env: o repositório é público)
PORT=8080
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/minicrm?retryWrites=true&w=majority
# URL pública mostrada no Swagger (opcional)
URL_PUBLICA=
# Origens liberadas no CORS (vazio = CORS desligado; só BFF e Function chamam este serviço)
CORS_ORIGINS=
